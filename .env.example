# ============================================================
#  TradingView -> Tradovate Bridge  —  configuration
#  Copy this file to ".env"  (cp .env.example .env)  and fill it in.
# ============================================================

# --- WHICH ACCOUNT TO TRADE ---------------------------------
# demo = paper / simulation  (demo.tradovateapi.com)
# live = REAL MONEY          (live.tradovateapi.com)
TRADOVATE_ENV=demo

# --- TRADOVATE CREDENTIALS  (ASK THE CLIENT FOR THESE) ------
# The username + password used to log in to Tradovate.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=

# API Key + Secret. The client creates these inside Tradovate:
#   Tradovate Trader -> Application Settings / Gear icon -> API Access
#   -> create an API Key  ->  it gives you a Key ("cid") and a Secret ("sec").
TRADOVATE_CID=
TRADOVATE_SEC=

# OPTIONAL: if the login has more than one account, set the account NAME here
# (e.g. DEMO1234567 or APEX-12345-01). Leave blank to auto-pick the first active one.
TRADOVATE_ACCOUNT_SPEC=
# OPTIONAL numeric override; normally leave blank (auto-detected):
TRADOVATE_ACCOUNT_ID=

# App identifiers — you can leave these as-is.
TRADOVATE_APP_ID=TV-Bridge
TRADOVATE_APP_VERSION=1.0

# --- WEBHOOK SECURITY ---------------------------------------
# A password that MUST be present in every TradingView alert ("secret": "...").
# Change this to a long random string and keep it private.
WEBHOOK_SECRET=CHANGE_ME_to_a_long_random_string

# OPTIONAL: only accept requests coming from TradingView's own IP addresses.
ENFORCE_IP_ALLOWLIST=false
ALLOWED_IPS=52.89.214.238,34.212.75.30,52.32.178.7

# --- SERVER -------------------------------------------------
# TradingView only allows webhook ports 80 or 443 — keep this 80.
PORT=80
HOST=0.0.0.0

# --- TRADING BEHAVIOUR --------------------------------------
# Default number of contracts when an alert doesn't specify a qty.
DEFAULT_QTY=1
# DRY_RUN=true -> logs what it WOULD do and places NO real orders. Use for the first test.
# Set to false once you've confirmed alerts arrive correctly.
DRY_RUN=true

# --- LOGGING ------------------------------------------------
LOG_LEVEL=info

# --- OPTIONAL NOTIFICATIONS  (off by default) ---------------
# Fill any of these in later if you want fills/errors pushed somewhere.
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT=
# NOTIFY_DISCORD_WEBHOOK=
